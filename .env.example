# ==============================================================================
# VOLTRON QUANTITATIVE ALPHA TERMINAL - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# NOTE: Never commit real API keys or sensitive credentials to version control.
# Copy this file to .env and insert your personal Alpaca Paper & Google AI keys.
# ==============================================================================

# Alpaca Paper Trading Credentials (https://app.alpaca.markets/paper/dashboard/overview)
ALPACA_API_KEY=YOUR_ALPACA_PAPER_API_KEY
ALPACA_SECRET_KEY=YOUR_ALPACA_PAPER_SECRET_KEY
ALPACA_PAPER=true
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Google Gemini 3.6 Pro API Key (https://aistudio.google.com/)
GEMINI_API_KEY=YOUR_GOOGLE_GEMINI_API_KEY
GEMINI_MODEL=gemini-3.6-pro

# Autonomous Execution Safety Configuration
# Set to 'false' to run in simulation/analysis mode; set to 'true' only for paper execution.
VOLTRON_TRADING_ENABLED=false
VOLTRON_ENVIRONMENT=PAPER

# Quantitative Risk Gate Limits
MAX_TRADE_RISK_PCT=0.01
MAX_DAILY_LOSS_PCT=0.02
MAX_PORTFOLIO_EXPOSURE_PCT=0.30
MAX_CONSECUTIVE_LOSSES=3
MIN_OPPORTUNITY_SCORE=70
MAX_SPREAD_PERCENT=0.10
